<?xml version="1.0" encoding="utf-8"?>
<!-- NEXALINK: виджет 4×1 — статус, сервер, скорость и кнопка питания -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wide_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="10dp">

    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:importantForAccessibility="no"
        android:src="@drawable/nexalink_logo" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/wide_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Не подключено"
            android:textColor="#0A1F3A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wide_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="NEXALINK · нажмите, чтобы включить"
            android:textColor="#566074"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/wide_button"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/widget_btn_off"
        android:importantForAccessibility="no"
        android:padding="15dp"
        android:src="@drawable/ic_power_24dp" />
</LinearLayout>
